# ─────────────────────────────────────────────────────────────────────────────
# WHICH FILE DO I COPY THIS TO?
#
#   .env.local   → the LOCAL Supabase stack. This is the DEFAULT dev target:
#                  `npm run dev` loads it and refuses to start if its
#                  SUPABASE_URL is not 127.0.0.1/localhost.
#                  Get the values from `supabase status`.
#
#   .env.remote  → the REMOTE project. OPT-IN ONLY, via `npm run dev:remote`,
#                  which prints a warning because every write is real.
#
#   .env         → DO NOT create one holding remote values. Nuxt loads `.env`
#                  by default, so `npx nuxt dev` or `nuxt build` would silently
#                  target production. scripts/check-dev-env.mjs fails on it.
#
# All three are gitignored; only this example file is committed.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — LOCAL values come from `supabase status`;
# remote values from: Supabase Dashboard → Settings → API
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=your-public-anon-key

# Server-only admin API access
# Recommended for `/api/admin/*` privileged reads/writes used by HOPNIC staff tools.
SUPABASE_SECRET_KEY=

# Optional deprecated fallback if your environment still uses the old name.
# Use only one of these server-only keys when possible.
# SUPABASE_SERVICE_KEY=your-service-role-key

# Omise / Opn Payments — test keys from Dashboard → Developers
# Public key is safe for frontend tokenization only.
NUXT_PUBLIC_OMISE_PUBLIC_KEY=pkey_test_xxx

# Server-only keys. Never expose these to the browser.
OMISE_SECRET_KEY=skey_test_xxx
OMISE_WEBHOOK_SECRET=base64_webhook_secret_from_dashboard

# KYC identity hashing — server-only, never expose to browser.
# Generate with: openssl rand -hex 32
KYC_HASH_SECRET=replace-with-secure-random-secret