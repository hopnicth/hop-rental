# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local Supabase CLI temp state
supabase/.temp/

# Local env files.
# LAYOUT (2026-07-26): the DEFAULT dev target is LOCAL. `.env.local` holds the
# local Supabase stack; the REMOTE project lives ONLY in `.env.remote` and is
# reached solely through `npm run dev:remote`. A `.env` holding remote values is
# a setup error — scripts/check-dev-env.mjs refuses to start on it, because Nuxt
# loads `.env` by default and `npx nuxt dev` would then target production.
# The `.env.*` glob already covers `.env.remote`; it is named here so the
# convention is discoverable from the ignore file itself.
.env
.env.*
.env.remote
!.env.example

# AI agent workspace temp files
.augment-*
*.exit

# Local reference / scratch files (never commit)
Ref*.html
"Ref *.html"

docs/task-runs/*.md
!docs/task-runs/.gitkeep

# Scratch / dated / AI-agent prompt docs (never commit new ones)
# NOTE: existing tracked copies are NOT untracked by this rule —
# remove them with `git rm --cached <file>` if you want them gone.
[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9] *.md
augment_*.md
# Skill workspaces + regenerable agent output (kept on disk, never committed)
.playwright-mcp/
.claude/skills/
.impeccable/
docs/superpowers/
DESIGN.md
PRODUCT.md
